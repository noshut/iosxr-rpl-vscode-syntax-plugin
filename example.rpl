# Example RPL — open with the extension installed to see highlighting + completions.
policy-global
  glbtag '100'
end-global

prefix-set RFC1918
  # private space incl. all subnets
  10.0.0.0/8 ge 8,
  172.16.0.0/12 ge 12,
  192.168.0.0/16 ge 16
end-set

as-path-set UPSTREAMS
  ios-regex '^65010_',
  ios-regex '_65020$'
end-set

community-set BLACKHOLE
  65535:666,
  no-export
end-set

extcommunity-set rt CUST-A
  65000:100
end-set

# Device-verified on IOS XR 24.3.1 — newer condition/action coverage.
route-policy FEATURE-SHOWCASE
  if destination is-best-path or destination longer-than (10.0.0.0/8) then
    set path-selection backup 1 install advertise
    set maximum-paths 8
  elseif community length ge 3 and extcommunity rt matches-any (65000:1) then
    set extcommunity color (1:1) additive
    delete prefix-sid
  elseif track WAN-CHECK is up or ospf-area is 0 then
    add rip-metric 2
    var globalVar1 100
  elseif mldp opaque vpnv4 or rib-has-route async (10.1.1.0/24) then
    set core-tree mldp-partitioned-p2mp
    set upstream-core-tree sr-p2mp
  elseif evpn-route-type is 5 then
    set advertise-evpn-gw-ip use-next-hop
  elseif large-community length le 10 or route-aggregated then
    set label explicit-null
    set load-balance ecmp-consistent
    set srv6-alloc-mode per-vrf
  elseif rd in (65000:1) or aggregate-contributor then
    set path-selection multipath advertise multipath-protect
    set on-demand-color 100
  else
    pass
  endif
end-policy

route-policy CUSTOMER-IN($asn)
  if destination in RFC1918 then
    drop
  elseif as-path in UPSTREAMS or as-path passes-through '$asn' then
    set local-preference 80
    set community (65000:$asn) additive
    pass
  elseif community matches-any BLACKHOLE then
    set next-hop discard
    done
  else
    set med igp-cost
    set tag $glbtag
    apply STANDARD-OUT
  endif
end-policy
