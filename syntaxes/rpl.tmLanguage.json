{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IOS XR RPL",
  "scopeName": "source.rpl",
  "patterns": [
    { "include": "#comment" },
    { "include": "#regex" },
    { "include": "#definition" },
    { "include": "#control" },
    { "include": "#actions" },
    { "include": "#conditions" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#parameter" },
    { "include": "#community" },
    { "include": "#ipaddress" },
    { "include": "#number" },
    { "include": "#string" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.rpl"
    },
    "regex": {
      "begin": "\\b(ios-regex|dfa-regex)\\s*(')",
      "beginCaptures": {
        "1": { "name": "support.function.regex.rpl" },
        "2": { "name": "punctuation.definition.string.begin.rpl" }
      },
      "end": "'",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.rpl" } },
      "name": "string.regexp.rpl"
    },
    "definition": {
      "match": "^\\s*(route-policy|prefix-set|as-path-set|community-set|large-community-set|rd-set|tag-set|esi-set|etag-set|mac-set|policy-global)\\b(?:\\s+(rt|soo|cost|bandwidth|opaque))?(?:\\s+([A-Za-z0-9][A-Za-z0-9._-]*))?|^\\s*(extcommunity-set)\\s+(rt|soo|cost|bandwidth|opaque)(?:\\s+([A-Za-z0-9][A-Za-z0-9._-]*))?",
      "captures": {
        "1": { "name": "storage.type.rpl" },
        "2": { "name": "storage.modifier.rpl" },
        "3": { "name": "entity.name.function.rpl" },
        "4": { "name": "storage.type.rpl" },
        "5": { "name": "storage.modifier.rpl" },
        "6": { "name": "entity.name.function.rpl" }
      }
    },
    "control": {
      "match": "\\b(if|then|elseif|else|endif|apply|end-policy|end-set|end-global|abort)\\b",
      "name": "keyword.control.rpl"
    },
    "actions": {
      "match": "\\b(set|delete|prepend|replace|remove|drop|pass|done|suppress-route|unsuppress-route)\\b",
      "name": "keyword.other.action.rpl"
    },
    "conditions": {
      "match": "\\b(destination|as-path|community|extcommunity|large-community|local-preference|med|aigp-metric|next-hop|origin|orf|path-type|protocol|rd|rib-has-route|route-has-label|route-type|source|tag|validation-state|vpn-distinguisher|weight|label|label-mode|level|metric-type|isis-metric|ospf-metric|rib-metric|rip-metric|rip-tag|eigrp-metric|qos-group|traffic-index|dampening|administrative-distance|fallback-vrf|flow-tag|forward-class|ip-precedence|spf-priority|path-selection|core-tree|lsm-root)\\b",
      "name": "support.function.attribute.rpl"
    },
    "operators": {
      "match": "\\b(and|or|not|in|is-empty|is-local|matches-any|matches-every|matches-within|neighbor-is|originates-from|passes-through|unique-length|length|eq|ge|le|is)\\b",
      "name": "keyword.operator.rpl"
    },
    "constants": {
      "match": "\\b(igp-cost|max-reachable|igp|egp|incomplete|internet|no-export|no-advertise|local-as|accept-own|graceful-shutdown|internal|external|local|type-1|type-2|level-1-2|level-1|level-2|additive|self|peer-address|discard|destination-vrf|valid|invalid|not-found|private-as|half-life|reuse|suppress|max-suppress|backdoor|multipath|bgp|ospf|isis|rip|eigrp|connected|static|subscriber|critical|flash-override|flash|immediate|priority|routine)\\b",
      "name": "constant.language.rpl"
    },
    "parameter": {
      "match": "\\$[A-Za-z0-9_]+",
      "name": "variable.parameter.rpl"
    },
    "community": {
      "match": "\\b(\\d+|\\*|\\[\\d+\\.\\.\\d+\\])(:(\\d+|\\*|\\[\\d+\\.\\.\\d+\\]))+",
      "name": "constant.numeric.community.rpl"
    },
    "ipaddress": {
      "match": "\\b(\\d{1,3}(\\.\\d{1,3}){3}|([0-9A-Fa-f]{0,4}:){2,7}[0-9A-Fa-f]{0,4})(/\\d{1,3})?",
      "name": "constant.numeric.ip.rpl"
    },
    "number": {
      "match": "\\b\\d+\\b",
      "name": "constant.numeric.rpl"
    },
    "string": {
      "match": "'[^']*'",
      "name": "string.quoted.single.rpl"
    }
  }
}
